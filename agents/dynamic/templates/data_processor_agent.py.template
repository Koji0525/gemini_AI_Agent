    async def execute(self, **kwargs) -> Dict[str, Any]:
        """
        Execute data processing
        
        Args:
            data: Data to process (list, dict, or pandas DataFrame)
            operation: Operation to perform (filter/transform/aggregate)
            params: Operation parameters (optional)
            
        Returns:
            Processed data
        """
        data = kwargs.get('data')
        operation = kwargs.get('operation')
        params = kwargs.get('params', {})
        
        if not data or not operation:
            raise ValueError("Both data and operation are required")
        
        if operation == 'filter':
            return await self._filter_data(data, params)
        elif operation == 'transform':
            return await self._transform_data(data, params)
        elif operation == 'aggregate':
            return await self._aggregate_data(data, params)
        else:
            raise ValueError(f"Unknown operation: {operation}")
    
    async def _filter_data(self, data: Any, params: Dict) -> Dict[str, Any]:
