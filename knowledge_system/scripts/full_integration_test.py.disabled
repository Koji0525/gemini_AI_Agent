#!/usr/bin/env python3
import os
import sys

# 絶対パス設定
current_dir = os.path.dirname(os.path.abspath(__file__))
parent_dir = os.path.dirname(current_dir)
utils_dir = os.path.join(parent_dir, "utils")

sys.path.insert(0, parent_dir)
sys.path.insert(0, utils_dir)


def test_imports():
    """インポートテスト"""
    print("🔧 インポートテスト開始...")
    try:
        # 修正されたデータベースモジュールをインポート
        print("✅ DatabaseManager インポート成功")

        # モデルモジュールをインポート
        print("✅ EmbeddingModel インポート成功")

        return True
    except ImportError as e:
        print(f"❌ インポートエラー: {e}")
        print(f"🔧 Pythonパス: {sys.path}")
        return False


def test_database():
    """データベーステスト"""
    print("\n🗄️ データベーステスト開始...")
    try:
        db_path = os.path.join(parent_dir, "database", "knowledge.db")
        db = DatabaseManager(db_path)

        # 統計取得
        stats = db.get_sync_stats()
        print(f"📊 データベース統計: {stats}")

        # テストデータ登録
        test_entry = {
            "title": "統合テスト",
            "content": "これは統合テスト用のナレッジエントリーです",
            "category": "test",
            "tags": "テスト,統合",
            "scenario": "general",
        }

        success = db.insert_knowledge_entry(test_entry)
        print(f"📝 テストデータ登録: {'成功' if success else '失敗'}")

        # 検索テスト
        results = db.search_entries(query="テスト", limit=5)
        print(f"🔍 検索結果: {len(results)}件")

        return True
    except Exception as e:
        print(f"❌ データベーステスト失敗: {e}")
        return False


def test_embedding():
    """埋め込みモデルテスト"""
    print("\n🧠 埋め込みモデルテスト開始...")
    try:
        model = EmbeddingModel()

        # テストテキスト
        test_text = "これはテスト用の文章です"
        embedding = model.get_embedding(test_text)

        if embedding is not None:
            print(f"✅ 埋め込み生成成功: {len(embedding)}次元")
            return True
        else:
            print("❌ 埋め込み生成失敗")
            return False
    except Exception as e:
        print(f"❌ 埋め込みモデルテスト失敗: {e}")
        return False


def test_vector_operations():
    """ベクトル操作テスト"""
    print("\n📊 ベクトル操作テスト開始...")
    try:
        db_path = os.path.join(parent_dir, "database", "knowledge.db")
        db = DatabaseManager(db_path)
        model = EmbeddingModel()

        # テストデータ
        test_text = "AIと機械学習"
        embedding = model.get_embedding(test_text)

        if embedding is None:
            print("❌ 埋め込み生成失敗のためスキップ")
            return False

        # ベクトル検索テスト
        results = db.vector_search(embedding, top_k=3)
        print(f"🔍 ベクトル検索結果: {len(results)}件")

        return True
    except Exception as e:
        print(f"❌ ベクトル操作テスト失敗: {e}")
        return False


def main():
    print("🚀 完全な統合テストを開始")
    print(f"🔧 作業ディレクトリ: {os.getcwd()}")
    print(f"🔧 スクリプトディレクトリ: {current_dir}")

    tests = [test_imports, test_database, test_embedding, test_vector_operations]

    results = []
    for test in tests:
        try:
            result = test()
            results.append(result)
        except Exception as e:
            print(f"❌ テスト実行中に例外: {e}")
            results.append(False)

    passed = sum(results)
    total = len(results)

    print(f"\n{'='*50}")
    print(f"📊 テスト結果: {passed}/{total} 成功")

    if passed == total:
        print("🎉 すべてのテストが成功しました！")
        return True
    else:
        print("💥 一部のテストが失敗しました")
        return False


if __name__ == "__main__":
    success = main()
    sys.exit(0 if success else 1)
