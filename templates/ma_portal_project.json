{
  "project_name": "ma_portal",
  "description": "M&Aポータルサイト構築プロジェクト",
  "version": "1.0.0",
  
  "post_types": [
    {
      "slug": "ma_company",
      "labels": {
        "name": "M&A企業情報",
        "singular_name": "企業情報",
        "add_new": "新規追加",
        "add_new_item": "新しい企業情報を追加",
        "edit_item": "企業情報を編集",
        "view_item": "企業情報を表示",
        "all_items": "全ての企業情報"
      },
      "menu_icon": "dashicons-building",
      "menu_position": 6,
      "supports": ["title", "editor", "thumbnail", "excerpt"],
      "has_archive": true,
      "rewrite": {
        "slug": "companies"
      }
    }
  ],
  
  "taxonomies": [
    {
      "slug": "ma_industry",
      "post_type": "ma_company",
      "labels": {
        "name": "業種",
        "singular_name": "業種",
        "add_new_item": "新しい業種を追加"
      },
      "hierarchical": true,
      "show_admin_column": true,
      "rewrite": {
        "slug": "industry"
      },
      "terms": [
        "IT・ソフトウェア",
        "製造業",
        "サービス業",
        "小売業",
        "建設業",
        "その他"
      ]
    }
  ],
  
  "acf_fields": {
    "key": "group_ma_company_details",
    "title": "企業詳細情報",
    "fields": [
      {
        "key": "field_location",
        "label": "所在地",
        "name": "location",
        "type": "text",
        "required": 1,
        "placeholder": "例: 東京都渋谷区"
      },
      {
        "key": "field_capital",
        "label": "資本金（万円）",
        "name": "capital",
        "type": "number",
        "required": 1,
        "min": 0,
        "placeholder": "例: 10000"
      },
      {
        "key": "field_employees",
        "label": "従業員数",
        "name": "employees",
        "type": "number",
        "required": 1,
        "min": 0,
        "placeholder": "例: 50"
      },
      {
        "key": "field_revenue",
        "label": "年商（万円）",
        "name": "revenue",
        "type": "number",
        "required": 1,
        "min": 0,
        "placeholder": "例: 100000"
      },
      {
        "key": "field_deal_type",
        "label": "希望条件",
        "name": "deal_type",
        "type": "select",
        "choices": {
          "売却希望": "売却希望",
          "買収希望": "買収希望"
        },
        "default_value": "売却希望",
        "ui": 1,
        "required": 1
      }
    ],
    "location": [
      [
        {
          "param": "post_type",
          "operator": "==",
          "value": "ma_company"
        }
      ]
    ],
    "position": "normal",
    "style": "default"
  },
  
  "admin_columns": {
    "enabled": true,
    "columns": [
      {
        "key": "industry",
        "label": "業種",
        "type": "taxonomy"
      },
      {
        "key": "location",
        "label": "所在地",
        "type": "field"
      },
      {
        "key": "capital",
        "label": "資本金",
        "type": "field",
        "format": "number"
      },
      {
        "key": "deal_type",
        "label": "希望条件",
        "type": "field"
      }
    ]
  }
}
